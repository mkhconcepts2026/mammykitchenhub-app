                Mammy Kitchen Hub
              </p>
              <h1 className="mt-1 truncate text-xl font-extrabold tracking-tight text-[#0b1220] md:text-2xl">
                Vendor Workspace
              </h1>
            </div>
            <div className="flex shrink-0 items-center gap-3">
              <span className="hidden rounded-full border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 sm:inline-flex">
                Kitchen Operations
              </span>
              <button type="button" onClick={logout} className="rounded-xl bg-[#ff6b00] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#e65f00] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-orange-200">Logout</button>
              <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-[#0b1220] text-sm font-bold text-white" aria-label="Vendor account">
                {(vendorName || "V").slice(0, 1).toUpperCase()}
              </div>
            </div>
          </header>

          <div className="mx-auto max-w-[1500px] p-4 md:p-8">
            {currentTab === "dashboard" && (
              <>
              {/* MKH_KITCHEN_PHOTO_FRAGMENT_FIX */}
              <div className="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
  <div className="flex flex-col gap-4 sm:flex-row sm:items-center">
    {kitchenImage ? (
      <img src={kitchenImage} alt="Current kitchen" className="h-28 w-36 rounded-xl object-cover" />
    ) : (
      <div className="flex h-28 w-36 items-center justify-center rounded-xl bg-slate-100 text-center text-xs text-slate-500">
        No kitchen photo
      </div>
    )}
    <div className="min-w-0 flex-1">
      <h2 className="text-lg font-bold text-[#0b1220]">Kitchen Photo</h2>
      <p className="mt-1 text-sm text-slate-500">
        Update the photo customers see for your kitchen. PNG or JPG, up to 5 MB.
      </p>
      <label className="mt-3 inline-flex cursor-pointer items-center rounded-xl bg-[#ff6b00] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#e65f00]">
        {photoUploading ? "Uploading photo..." : "Change Kitchen Photo"}
        <input type="file" accept="image/png,image/jpeg,.png,.jpg,.jpeg" className="hidden" disabled={photoUploading} onChange={handleKitchenPhotoChange} />
      </label>
      {photoUploading && <p role="status" className="mt-2 text-sm text-slate-500">Uploading and saving your photo...</p>}
      {photoMessage && <p role="status" className="mt-2 text-sm text-green-700">{photoMessage}</p>}
      {photoError && <p role="alert" className="mt-2 text-sm text-red-600">{photoError}</p>}
    </div>
  </div>
</div>
<VendorDashboardTab vendorName={vendorName} orders={orders} />
            
              </>)}

        {currentTab === "orders" && (
          <VendorOrdersTab
            orders={orders}
            loadingOrders={loadingOrders}
            updateOrderStatus={updateOrderStatus}
          />
        )}
        {currentTab === "menu" && (
          <VendorMenuTab
            menuItems={menuItems}
            showForm={showForm}
            setShowForm={setShowForm}
            editingId={editingId}
            setEditingId={setEditingId}
            form={form}
            setForm={setForm}
            imageFile={imageFile}
            setImageFile={setImageFile}
            saveMenuItem={saveMenuItem}
            editMenuItem={editMenuItem}
            deleteMenuItem={deleteMenuItem}
            toggleAvailability={toggleAvailability}
          />
        )}
       {currentTab === "earnings" && (

  <div className="space-y-6">

    <div>

      <h1 className="text-5xl font-bold">
        Earnings & Payouts
      </h1>

      <p className="text-gray-500 text-lg">
        Track your revenue and manage payouts
      </p>

    </div>

    <div className="
      grid
      grid-cols-1
      md:grid-cols-3
      gap-6
    ">

  <div
  className="
    bg-orange-500
    text-white
    rounded-3xl
    p-6
  "
>

  <p className="text-orange-100">
    Available for Withdrawal
  </p>

  <h2
    className="
      text-4xl
      font-bold
      mt-2
    "
  >
    ₦{pendingBalance.toLocaleString()}
  </h2>

  <p
    className="
      text-orange-100
      mt-2
    "
  >
    {
      isPayoutWindowOpen

        ? "Withdrawal window is open"

        : "Withdrawal window opens Friday 4PM"
    }
  </p>

  <button
    onClick={requestPayout}
    disabled={
      !isPayoutWindowOpen ||
      isSubmittingPayout ||
      pendingBalance <= 0 ||
      hasPendingPayout
    }
    className={`
      mt-6
      px-5
      py-3
      rounded-xl
      font-semibold
      w-full

      ${
        hasPendingPayout

          ? "bg-blue-100 text-blue-600 cursor-not-allowed"

          : isPayoutWindowOpen

          ? "bg-white text-orange-500"

          : "bg-gray-300 text-gray-500 cursor-not-allowed"
      }
    `}
  >

    {

      isSubmittingPayout

        ? "Submitting..."

        : hasPendingPayout

        ? "Payout Request Submitted"

        : isPayoutWindowOpen

        ? "Withdraw Funds"

        : "Available Friday 4PM - Sunday 11:59PM"

    }

  </button>

</div>

<div className="
  bg-white
  rounded-3xl
  p-6
  shadow-sm
">

  <p className="text-gray-500">
   Lifetime Earnings
  </p>

  <h2 className="
    text-4xl
    font-bold
    mt-2
  ">
    ₦{totalEarned.toLocaleString()}
  </h2>

  <p className="
    text-blue-600
    mt-2
  ">
    Total revenue earned on MKH
  </p>

</div>

<div className="
  bg-white
  rounded-3xl
  p-6
  shadow-sm
">

  <p className="text-gray-500">
     Pending Payout
  </p>

  <h2 className="
    text-4xl
    font-bold
    mt-2
  ">
    ₦{pendingBalance.toLocaleString()}
  </h2>

  <p
    className={`
      mt-2
      ${
        isPayoutWindowOpen
          ? "text-green-600"
          : "text-orange-500"
      }
    `}
  >
    Available on {nextFridayText}
  </p>

</div>

    </div>

    <div className="
  bg-white
  rounded-3xl
  p-6
  shadow-sm
">

  <p className="text-gray-500">
    Successful Orders
  </p>

  <h2 className="
    text-4xl
    font-bold
    mt-2
  ">
    {successfulOrders}
  </h2>

  <p className="
    text-green-600
    mt-2
  ">
    Completed Deliveries
  </p>

</div>

    <div className="
      bg-white
      rounded-3xl
      p-8
      shadow-sm
    ">

      <h3 className="
        text-2xl
        font-bold
        mb-6
      ">
        Transaction History
      </h3>

      {orders.length === 0 ? (

        <p className="text-gray-500">
          No transactions yet.
        </p>

      ) : (

        orders.map((order) => (

          <div
            key={order.id}
            className="
              border-b
              py-4
              flex
              justify-between
              items-center
            "
          >

            <div>

              <p className="font-semibold">
                Order #{order.id.slice(0,8)}
              </p>

              <p className="text-sm text-gray-500">
                {new Date(
                  order.created_at
                ).toLocaleDateString()}
              </p>

            </div>

            <div className="text-right">

              <p className="
                font-bold
              ">
                ₦{Number(
                  order.total
                ).toLocaleString()}
              </p>

              <p
                className={`
                  text-sm
                  ${
                    order.status ===
                    "delivered"
                      ? "text-green-600"
                      : "text-orange-500"
                  }
                `}
              >
                {order.status}
              </p>

            </div>

          </div>

        ))

      )}

    </div>

  </div>

)}

{currentTab === "earnings" && (
<div
  className="
    bg-white
    rounded-3xl
    p-8
    shadow-sm
    mt-8
  "
>

  <h3
    className="
      text-2xl
      font-bold
      mb-6
    "
  >
    Withdrawal History
  </h3>

  {payoutHistory.length === 0 ? (

    <p className="text-gray-500">
      No withdrawal requests yet.
    </p>

  ) : (

    payoutHistory.map((payout) => (

      <div
        key={payout.id}
        className="
          border-b
          py-4
          flex
          justify-between
          items-center
        "
      >

        <div>

          <p className="font-semibold">
            ₦{Number(
              payout.amount
            ).toLocaleString()}
          </p>

          <p className="text-sm text-gray-500">
            {new Date(
              payout.requested_at
            ).toLocaleDateString()}
          </p>

        </div>

        <div>

          <span
            className={`
              px-3
              py-2
              rounded-full
              text-xs
              font-semibold

              ${
                payout.status === "pending"
                  ? "bg-orange-100 text-orange-700"
                  : payout.status === "approved"
                  ? "bg-blue-100 text-blue-700"
                  : payout.status === "processing"
                  ? "bg-purple-100 text-purple-700"
                  : payout.status === "paid"
                  ? "bg-green-100 text-green-700"
                  : "bg-red-100 text-red-700"
              }
            `}
          >
            {payout.status.toUpperCase()}
          </span>

        </div>

      </div>

    ))

  )}

</div>
)}

       {currentTab === "kyc" && (
  <VendorKYCTab kycStatus={kycStatus} reviewNotes={kycReviewNotes} onResubmit={submitKyc} submitting={submittingKyc} />
)}

          </div> {/* End Page Content */}
        </div> {/* End Main Content */}
      </div> {/* End Flex Layout */}
    </main>

  );

}