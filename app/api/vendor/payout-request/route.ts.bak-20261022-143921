import { NextResponse } from "next/server";
import { createClient } from "@/lib/supabase/server";
import { adminClient } from "@/lib/supabase/admin";

export const runtime = "nodejs";

export async function POST() {
  try {
    // Authenticate using the caller's session cookie.
    const supabase = await createClient();
    const {
      data: { user },
      error: authError,
    } = await supabase.auth.getUser();

    if (authError || !user) {
      return NextResponse.json(
        { success: false, message: "Please sign in again." },
        { status: 401 }
      );
    }

    // Resolve vendor identity from the authenticated profile.
    const { data: profile, error: profileError } = await adminClient
      .from("profiles")
      .select("vendor_id, role, status")
      .eq("id", user.id)
      .maybeSingle();

    if (
      profileError ||
      !profile?.vendor_id ||
      String(profile.role ?? "").toLowerCase() !== "vendor" ||
      String(profile.status ?? "").toLowerCase() !== "active"
    ) {
      return NextResponse.json(
        { success: false, message: "An active vendor account is required." },
        { status: 403 }
      );
    }

    // Use the database wallet balance, never an amount supplied by the browser.
    const { data: wallet, error: walletError } = await adminClient
      .from("vendor_wallets")
      .select("available_balance")
      .eq("vendor_id", profile.vendor_id)
      .maybeSingle();

    if (walletError) {
      console.error("Vendor payout wallet lookup failed:", walletError);
      return NextResponse.json(
        { success: false, message: "Could not verify your wallet balance." },
        { status: 500 }
      );
    }

    const amount = Number(wallet?.available_balance ?? 0);

    if (!Number.isFinite(amount) || amount <= 0) {
      return NextResponse.json(
        { success: false, message: "There is no available balance to withdraw." },
        { status: 400 }
      );
    }

    // Prevent a second outstanding request. This check alone is not an atomic
    // concurrency lock; database-level protection is needed for full idempotency.
    const { data: existing, error: existingError } = await adminClient
      .from("payout_requests")
      .select("id")
      .eq("requester_id", profile.vendor_id)
      .eq("requester_type", "vendor")
      .eq("status", "pending")
      .limit(1);

    if (existingError) {
      console.error("Vendor payout duplicate check failed:", existingError);
      return NextResponse.json(
        { success: false, message: "Could not check existing payout requests." },
        { status: 500 }
      );
    }

    if (existing && existing.length > 0) {
      return NextResponse.json(
        { success: false, message: "You already have a pending payout request." },
        { status: 409 }
      );
    }

    const { data: payout, error: insertError } = await adminClient
      .from("payout_requests")
      .insert({
        requester_id: profile.vendor_id,
        requester_type: "vendor",
        amount,
        status: "pending",
      })
      .select("id, amount, status, requested_at")
      .single();

    if (insertError || !payout) {
      console.error("Vendor payout request insert failed:", insertError);
      return NextResponse.json(
        { success: false, message: "Could not submit your payout request." },
        { status: 500 }
      );
    }

    return NextResponse.json({
      success: true,
      message: "Payout request submitted for review.",
      payout,
    });
  } catch (error) {
    console.error("Vendor payout request failed:", error);
    return NextResponse.json(
      { success: false, message: "An unexpected error occurred." },
      { status: 500 }
    );
  }
}
