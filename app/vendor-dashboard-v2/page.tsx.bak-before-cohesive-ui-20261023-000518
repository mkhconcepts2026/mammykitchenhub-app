  } = await supabase.auth.getUser();

  if (!user) return;

  const {
    data,
    error
  } = await supabase
    .from("vendor_kyc")
    .select("*")
    .eq("vendor_id", user.id)
    .order(
      "created_at",
      { ascending: false }
    )
    .limit(1);

  if (
    error ||
    !data ||
    data.length === 0
  ) return;

  const kyc = data[0];

  console.log(
    "KYC RECORD:",
    kyc
  );

  setKycStatus(
    kyc.status === "pending"
      ? "Pending Review"
      : kyc.status === "approved"
      ? "Verified"
      : kyc.status
  );

}

